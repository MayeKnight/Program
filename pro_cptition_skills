    priority_queue<int, vector<int>, greater<int>> minHeap;
    int k;
    
public:   // 成员函数(也叫"方法"), 以下是公有成员, 外部可以访问, 即外部可以调用这两个函数.
    KthLargest(int k, vector<int>& nums) {  //构造函数, 用于初始化对象
        this->k = k;                        // this 是指向当前对象的指针, 比方说下面举例中声明了该类的名为 obj 的对象, 此时 this 就是指向 当前对象obj 的指针, this->k 就是当前对象的成员变量k(private私有变量), =右边的k 指的是构造函数传入的参数k, 整句意思: 把参数k的值赋给对象的成员变量k
        for (int num : nums) {
            add(num);
        }
    }
    
    int add(int val) {
        if (minHeap.size() < k) {
            minHeap.push(val);
        } else if (val > minHeap.top()) {
            minHeap.pop();
            minHeap.push(val);
        }
        return minHeap.top();
    }
};

//实际使用举例
int main(){
    KthLargest obj(3, {4, 5, 8, 2});  //初始化一个名为obj的对象

    //✅可以调用public方法
    int result = obj.add(3);

    //❌不能访问private成员
    //obj.minHeap.push(10);   //编译错误! minHeap 是私有的
    //obj.k = 5;              //编译错误! k 是私有的

    return 0;
}
===
