//字符串流-动态缓冲区
===
#include <sstream>
using namespace std;

stringstream ss("123 456 789");  //创建

//✅️ 自动解析不同类型
int a, b, c;
ss >> a >> b >> c;   //a=123, b=456, c=789, 流式操作(<<或>>)自动以空白字符(包括空格)作为分隔符, 并且会将 string类型 自动转换为 int类型

//✅️ 自动格式转换
