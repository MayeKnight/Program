(3)priority_queue 与 vector + heap算法(堆算法)实现小顶堆的比较
===
//priority_queue堆(优先队列) 实现小顶堆
priority_queue<int, vector<int>, greater<int>> pq;
pq.push(3);

//vector + heap算法实现小顶堆
vector<int> v;
v.push_back(3);
push_heap(v.begin(), v.end(), greater<int>());    //注意第三个参数的区别, vector + heap算法有(), 而priority_queue堆(优先队列)则没有
或
vector<int> v1 = {7, 5, 3, 1, 4};
make_heap(v1.begin(), v1.end(), greater<int>());

//并且由于priority_queue是一个封装好的容器(容器适配器), 而heap算法是裸的算法函数, 封装程度不同, 导致其使用方式的"一致性保障"也不同
---
//priority_queue进行入堆和出堆操作时, 小顶堆和大顶堆的入堆和出堆方式均为
priority<int> pq1;    //大顶堆
pq1.push(val);  //入堆
pq1.pop();   //出堆

priority<int, vector<int>, greater<int>> pq2;  //小顶堆
pq2.push(val);   //入堆
pq2.pop();    //出堆

//而vector+heap算法进行入堆和出堆操作时, 小顶堆和大顶堆的入堆和出堆方式则不同, 小顶堆的heap算法需要传入比较器 greater<int>(), 来告知执行的是大顶堆还是小顶堆的入堆或出堆操作
make_heap(v1.begin(), v1.end());   //大顶堆

v1.push_back(val);                  
push_heap(v1.begin(), v1.end());   //入堆

pop_heap(v1.begin(), v1.end());
v1.pop_back();                     //出堆

make_heap(v2.begin(), v2.end(), greater<int>());   //小顶堆

v2.push_back(val);
push_heap(v2.begin(), v2.end(), greater<int>());   //入堆

pop_heap(v2.begin(), v2.end(), greater<int>());
v2.pop_back();                                     //出堆

//说白了, 声明priority_queue这个容器适配器时, priority_queue会帮你把比较器(默认或greayer<int>)"绑定"到对象身上了, 在后续的入堆和出堆操作中, 不用每次都说一遍.
//而 heap算法, 相当于调用对应函数, 则要说明.
---

