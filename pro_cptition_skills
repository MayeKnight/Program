vector<int> convertToVector(const deque<int>& dq){
    return vector<int>(dq.begin(), dq.end());
}
int main(){
    deque<int> dq= {10, 20, 30, 40, 50};
    vector<int> vec = convertToVector(dq);  //将deque<int> 类型的dq 转为了 vector<int> 类型的 vec;

    //输出vector验证
    for(int x : vec){
        cout << x << " ";    //输出10, 20, 30, 40, 50
    }
}
